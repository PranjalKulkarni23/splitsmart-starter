# SplitSmart — environment variables
#
# Copy this file to ".env.local" and fill in your own values. NEVER commit real keys.
#
#   cp .env.example .env.local
#
# You don't need any of these for Hour 2 (the basic app). You'll add them as you go:

# --- Hour 3: the AI brain (Google Gemini) ---
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_api_key_here

# --- Hour 5: logins + database (Supabase) ---
# From your Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
